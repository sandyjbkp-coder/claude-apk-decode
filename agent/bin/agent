#!/bin/bash
# agent - Task planner with safety policy
# Part of Android Self-Healing Autonomous Agent (v1.0.0)
#
# Usage: agent <task description>
#
# This script plans and tracks tasks, routing executable commands to agent-run
# and read-only queries through appropriate channels.

set -euo pipefail

AGENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MEMORY_DIR="$AGENT_DIR/memory"
KNOWLEDGE_DIR="$MEMORY_DIR/knowledge"
LOGS_DIR="$AGENT_DIR/logs"
WORKSPACE_DIR="$AGENT_DIR/workspace"
SESSION_FILE="$MEMORY_DIR/sessions/current-session.json"
LOG_FILE="$LOGS_DIR/agent-session.log"

# Ensure directories exist
mkdir -p "$LOGS_DIR" "$WORKSPACE_DIR" "$MEMORY_DIR/sessions"

log() {
    local level="$1"
    shift
    local msg="$*"
    local ts
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "[$ts] [$level] $msg" | tee -a "$LOG_FILE" >&2 2>/dev/null || echo "[$ts] [$level] $msg"
}

# Load autostart memory if available
load_memory() {
    if [ -f "$MEMORY_DIR/autostart/session-init.md" ]; then
        log "INFO" "Loading autostart memory: session-init.md"
    fi
    if [ -f "$KNOWLEDGE_DIR/failure-patterns.md" ]; then
        log "INFO" "Loading failure patterns memory"
    fi
    if [ -f "$KNOWLEDGE_DIR/command-repair-playbook.md" ]; then
        log "INFO" "Loading command repair playbook"
    fi
    if [ -f "$KNOWLEDGE_DIR/retry-policy.md" ]; then
        log "INFO" "Loading retry policy memory"
    fi
}

# Initialize session
init_session() {
    local task_desc="$1"
    local session_id
    session_id=$(date +%s)
    cat > "$SESSION_FILE" <<EOF
{
  "session_id": "$session_id",
  "started_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "task": "$task_desc",
  "status": "planning",
  "attempts": 0,
  "fixes_applied": 0,
  "commands_run": 0
}
EOF
    log "INFO" "Session initialized: $session_id — task: $task_desc"
}

# Safety policy check
safety_check() {
    local cmd="$1"
    # Block destructive commands without explicit confirmation
    case "$cmd" in
        rm*|dd*|mkfs*|format*|fdisk*)
            log "WARN" "Potentially destructive command detected: $cmd"
            echo "WARNING: Destructive command detected. Type 'confirm' to proceed: "
            read -r confirm
            if [ "$confirm" != "confirm" ]; then
                log "ERROR" "Command blocked by safety policy"
                exit 1
            fi
            ;;
    esac
}

# Main entry
main() {
    if [ $# -lt 1 ]; then
        echo "Usage: $0 <task description>"
        echo "Example: $0 'storage cleanup report'"
        exit 1
    fi

    local task_desc="$*"

    log "INFO" "=== Android Self-Healing Agent (v1.0.0) ==="
    log "INFO" "Task: $task_desc"

    load_memory
    init_session "$task_desc"

    # Check for known failure patterns before planning
    if [ -f "$KNOWLEDGE_DIR/failure-patterns.md" ]; then
        log "INFO" "Checking known failure patterns..."
    fi

    # Delegate to agent-run if the task looks like a command
    # Otherwise, store as a planning task in workspace
    local task_file="$WORKSPACE_DIR/task-$(date +%s).md"
    cat > "$task_file" <<EOF
# Task: $task_desc

**Session:** $(cat "$SESSION_FILE" | grep session_id | head -1 | cut -d'"' -f4)
**Created:** $(date -u +"%Y-%m-%dT%H:%M:%SZ")
**Status:** Planning

## Plan

1. Analyze task requirements
2. Check memory for similar past failures
3. Execute via agent-run with retry policy
4. Record results and update memory

## Notes

Auto-generated by agent task planner.
EOF

    log "INFO" "Task plan saved to: $task_file"
    log "INFO" "Use 'agent-run <command>' to execute commands with self-healing retry"
    log "INFO" "Use 'agent-status' to check system status"

    echo ""
    echo "=== Task Planned ==="
    echo "Task: $task_desc"
    echo "Plan file: $task_file"
    echo ""
    echo "Next steps:"
    echo "  1. agent-run '<command>'   # Execute a command"
    echo "  2. agent-status            # Check system health"
    echo ""
}

main "$@"
